# ============================================================
# MedVault environment variables — EXAMPLE FILE
# ============================================================
# This file is safe to commit to git — it has no real secrets in it,
# just the NAMES of the values the app needs.
#
# To actually run the app: copy this file to `.env` (same folder) and
# fill in real values. `.env` is gitignored, so your real secrets never
# get uploaded to GitHub.
#
# "REQUIRED" = the backend refuses to start without this.
# "Day 2"    = collected now so you don't have to context-switch later,
#              but nothing reads it yet. Safe to leave blank today.
# ============================================================

# --- Database: Neon (PostgreSQL) --- REQUIRED
# Where to get it: Neon dashboard -> your project -> Connection Details.
# Must include sslmode=require (Neon requires an encrypted connection).
# Shape: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Auth: Firebase (phone OTP) --- REQUIRED
# Where to get it: Firebase console -> Project settings -> Service
# accounts -> "Generate new private key". That downloads a JSON file —
# open it and paste its ENTIRE contents here as ONE LINE (no line breaks).
# The backend only VERIFIES tokens with this; it never sends SMS itself.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- File storage: Cloudflare R2 --- REQUIRED
# Where to get it: Cloudflare dashboard -> R2 -> Manage API tokens ->
# Create API token (needs read/write access to your bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The S3-compatible endpoint for your account. Shape:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# --- Redis: Upstash --- (Day 2, not wired up yet — safe to leave blank)
# Where to get it: Upstash dashboard -> your database -> connection string.
REDIS_URL=

# --- OCR: Google Cloud Vision --- (Day 2, not wired up yet — safe to leave blank)
# Where to get it: Google Cloud Console -> APIs & Services -> Credentials
# -> Create API key (scoped to the Vision API).
GOOGLE_VISION_API_KEY=

# --- AI explanations: Claude (Anthropic) --- (Day 2, not wired up yet — safe to leave blank)
# Where to get it: console.anthropic.com -> API Keys -> Create Key.
ANTHROPIC_API_KEY=
