# ============================================================
# MedVault environment variables — EXAMPLE FILE
# ============================================================
# This file is safe to commit to git — it has no real secrets in it,
# just the NAMES of the values the app needs.
#
# To actually run the app: copy this file to `.env` (same folder) and
# fill in real values. `.env` is gitignored, so your real secrets never
# get uploaded to GitHub.
#
# "REQUIRED" = the backend refuses to start without this.
# "Day 2"    = collected now so you don't have to context-switch later,
#              but nothing reads it yet. Safe to leave blank today.
# ============================================================

# --- Database: Neon (PostgreSQL) --- REQUIRED
# Where to get it: Neon dashboard -> your project -> Connection Details.
# Must include sslmode=require (Neon requires an encrypted connection).
# Shape: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Auth: Firebase (phone OTP + Google sign-in) --- REQUIRED (one of the two below)
# Where to get it: Firebase console -> Project settings -> Service
# accounts -> "Generate new private key". That downloads a JSON file.
# The backend only VERIFIES tokens with this; it never sends SMS or
# talks to Google itself.
#
# Option A (recommended, especially on Windows): point at the
# downloaded file directly - no copy/paste formatting to get wrong.
# Relative paths resolve from wherever you run `uvicorn` (usually
# backend/). Keep the file OUTSIDE this repo, or make sure its name
# matches something already in .gitignore (e.g. *.json isn't ignored
# by default - don't add a real credential file to a tracked path).
FIREBASE_SERVICE_ACCOUNT_FILE=
#
# Option B: open the downloaded file in a text editor, copy the ENTIRE
# contents onto one line, and paste it here instead. Only used if
# FIREBASE_SERVICE_ACCOUNT_FILE above is blank.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- File storage: Cloudflare R2 --- REQUIRED
# Where to get it: Cloudflare dashboard -> R2 -> Manage API tokens ->
# Create API token (needs read/write access to your bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The S3-compatible endpoint for your account. Shape:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# --- Redis: Upstash (REST API) --- REQUIRED
# Powers the background job queue. We use Upstash's REST API (not a
# raw TCP connection), which needs a URL + a token, not one connection
# string.
# Where to get it: Upstash dashboard -> your database -> REST API
# section. Upstash shows these under exactly these two names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OCR provider --- REQUIRED (has a safe default: blank = "tesseract")
# "tesseract" (default) = free, runs locally, no API key, no billing -
#   needs the Tesseract program installed on your machine (see SETUP.md).
# "google_vision" = calls the Google Cloud Vision API instead - needs
#   billing enabled on your Google Cloud project AND a real
#   GOOGLE_VISION_API_KEY below. Switching later is exactly this one
#   setting - see "Switching OCR to Google Vision" in SETUP.md.
OCR_PROVIDER=tesseract

# --- OCR: Google Cloud Vision --- only used if OCR_PROVIDER=google_vision above
# Where to get it: Google Cloud Console -> APIs & Services -> Credentials
# -> Create API key (scoped to the Vision API). Also requires billing
# enabled on the project - see SETUP.md.
GOOGLE_VISION_API_KEY=

# --- AI extraction: Claude (Anthropic) --- REQUIRED
# Every processed report is sent to Claude to turn its OCR text into
# structured test result rows (see backend/app/ai/).
# Where to get it: console.anthropic.com -> API Keys -> Create Key.
ANTHROPIC_API_KEY=

# --- Trust chain confidence threshold --- optional (has a safe default: blank = 0.8)
# Every extracted result must score at least this AI confidence (0.0-1.0)
# to be trusted; below it, the result is routed to review_required no
# matter how clean it otherwise looks (see backend/app/trust/). Raise
# this to be stricter about what counts as "trusted", lower it to send
# fewer results to review.
TRUST_CONFIDENCE_THRESHOLD=0.8
