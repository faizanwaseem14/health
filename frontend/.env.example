# ============================================================
# HealthVault frontend environment variables — EXAMPLE FILE
# ============================================================
# This file is safe to commit to git — it has no real secrets in it,
# just the NAMES of the values the app needs.
#
# To actually run the app: copy this file to `.env` (same folder).
# `.env` is gitignored, so any local overrides never get uploaded to
# GitHub. For local development against the backend on your own
# machine, the value below already points at the right place — you
# usually don't need to change anything.
#
# Vite only exposes variables prefixed with VITE_ to the browser -
# see https://vite.dev/guide/env-and-mode.html
# ============================================================

# Where the HealthVault backend API is running.
# Local development (backend started with `uvicorn app.main:app`):
VITE_API_BASE_URL=http://localhost:8000

# --- Firebase (phone sign-in) ---
# Where to get these: Firebase console -> Project settings -> General ->
# "Your apps" -> the web app's config object. These are all PUBLIC
# client identifiers (not secrets) - Firebase's own docs say it's safe
# for them to end up in a browser bundle - but they still belong here,
# not hardcoded, so switching Firebase projects is a config change.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
